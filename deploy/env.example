# cp deploy/env.example deploy/.env and fill in. Never commit deploy/.env.
# Generate each secret with: head -c 32 /dev/urandom | base64

POSTGRES_PASSWORD=
SESSION_SECRET=

# Секрет приложения Meta — подписывает вебхуки.
META_APP_SECRET=
# Строка для проверки вебхука, та же, что в настройках Meta.
META_WEBHOOK_VERIFY_TOKEN=
# ID приложения Meta и ID конфигурации Login for Business — для подключения номера с телефона.
META_APP_ID=
META_ES_CONFIG_ID=
# Ключ шифрования токенов в базе, ровно 32 байта в base64.
CREDENTIALS_KEY=
# Куда складывать файлы из WhatsApp. Значения здесь compose.yml не читает: путь внутри
# контейнера зафиксирован там же, чтобы совпадать с именованным томом media. Эта строка
# остаётся для единообразия с server/.env, где переменная действительно используется.
MEDIA_DIR=var/media
# Как сервер виден снаружи — из него собирается адрес вебхука.
PUBLIC_URL=
