# Скопируйте в .env.local и поправьте под себя.
#
# ВАЖНО: всё, что начинается с VITE_, попадает в собранный бандл и видно любому,
# кто откроет исходники страницы. Токены Meta, amoCRM и WhatsApp сюда класть
# нельзя — они живут только на бэкенде.

# Базовый адрес API. /api — фронт ходит на свой же origin
# (так и надо, если nginx на VPS отдаёт и статику, и /api).
VITE_API_URL=/api

# Куда dev-сервер проксирует /api во время разработки. Выберите одно:
#
# Бэк на VPS:
# VITE_API_PROXY=https://api.example.com
#
# Бэк локально (npm --prefix server run dev в соседнем терминале):
VITE_API_PROXY=http://localhost:3000
