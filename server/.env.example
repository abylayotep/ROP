# cp server/.env.example server/.env — for local development only.
# Loaded automatically by `npm run dev`; in production the environment comes from
# deploy/.env through Compose and this file is never read.
#
# Nothing here carries a VITE_ prefix and nothing ever should: that prefix compiles
# a value into the browser bundle.

DATABASE_URL=postgres://rakurs:rakurs@localhost:55433/rakurs_dev

# Any 32+ characters will do locally. Generate a real one for the server:
#   head -c 32 /dev/urandom | base64
SESSION_SECRET=local-development-secret-change-me

# Секрет приложения Meta. Им подписан каждый вебхук — без него мы не отличим
# доставку от Meta от чужого запроса. Meta → приложение → Основные → App Secret.
META_APP_SECRET=

# Строка, которую Meta присылает при проверке вебхука и ждёт обратно.
# Придумайте любую и вставьте её же в настройках вебхука в Meta.
META_WEBHOOK_VERIFY_TOKEN=

# ID приложения Meta и ID конфигурации Facebook Login for Business. Нужны, чтобы
# подключить номер, который уже живёт в WhatsApp Business на телефоне (Embedded Signup).
# Meta → приложение → Основные → App ID; Вход через Facebook для компаний → Конфигурации.
META_APP_ID=
META_ES_CONFIG_ID=

# Ключ шифрования токенов в базе. Ровно 32 байта в base64:
#   head -c 32 /dev/urandom | base64
# Потеряете — токены придётся вводить заново.
CREDENTIALS_KEY=

# Куда складывать файлы из WhatsApp. Локально можно оставить как есть.
MEDIA_DIR=var/media

# Как сервер виден снаружи. Локально — адрес туннеля, на VPS — домен.
# Из него собирается адрес вебхука, который вы вставляете в Meta.
PUBLIC_URL=http://localhost:3000
